# Moneymatters production environment
# Configure these values in Plesk / Node.js application environment variables.
# Never commit real credentials or secrets to this file.

# Server listener. Plesk normally supplies PORT automatically; keep this only for local/self-hosted runs.
PORT=3000

# Supabase public client configuration. These values are safe for browser use when RLS is correctly configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# CRITICAL: server-only Supabase administrator credential.
# NEVER expose this value to browser code, NEXT_PUBLIC_* variables, source control, or client bundles.
# Required by trusted server-side operations such as receipt PDF generation and protected workers.
SUPABASE_SERVICE_ROLE_KEY=

# Public application URL used by receipt/notification delivery links and PDF attachments.
MONEYMATTERS_PUBLIC_URL=

# Notification providers (configure only the channels your business uses).
# Keep every credential below server-side; none should be prefixed with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TELEGRAM_BOT_TOKEN=

# Test-only environment variables are intentionally not populated here.
# See the test files for the exact TEST_* and E2E_* variables required by integration/smoke tests.
