# Moneymatters production environment
# Configure these in Plesk / Node.js application environment variables.
# Never commit real Supabase credentials to this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public application URL used by receipt/notification delivery links and PDF attachments.
MONEYMATTERS_PUBLIC_URL=

# Notification providers (configure only the channels your business uses).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TELEGRAM_BOT_TOKEN=
