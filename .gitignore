# See https://help.github.com/articles/ignoring-files/ for more information.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Android signing keys & credential configs
*.jks
*.keystore
android/key.properties
key.properties

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated canonical Money Matters branding assets (created by scripts/prepare-brand-assets.js).
/app/icon.png
/app/apple-icon.png
/app/favicon.ico
/public/moneymatters-192.png
/public/moneymatters-512.png
/public/moneymatters-pdf.png
/public/icons/moneymatters.svg
/android/app/src/main/res/mipmap-*/ic_launcher.png
/android/app/src/main/res/mipmap-*/ic_launcher_round.png
/android/app/src/main/res/mipmap-*/ic_launcher_foreground.png
