{
  "name": "invoice-automation-saas",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade multi-business invoicing and financial operations software built with Next.js, Node.js, and Supabase/PostgreSQL.",
  "repository": {
    "type": "git",
    "url": "https://github.com/svtrackpune/invoice-automation-saas.git"
  },
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.js",
    "start": "node server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:financial && node --test tests/*.test.mjs",
    "test:financial": "node --test tests/financial-invariants.test.mjs",
    "test:production-smoke": "node --test tests/production-smoke.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "next": "15.5.27",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "4.6.5",
    "@andreeewill/exceljs": "5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "0.35.5",
    "postcss": "8.5.28"
  }
}
